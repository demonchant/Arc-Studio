# npm install configuration for Vercel and CI.
#
# legacy-peer-deps=true is required because @circle-fin/developer-controlled-wallets
# depends on @solana/kit@5.5.1, whose sub-packages declare
# peerOptional typescript@"^5.0.0". npm 11 strict peer resolution incorrectly
# treats this as an ERESOLVE conflict even though typescript@5.9.3 satisfies ^5.0.0.
# This flag restores the pre-npm-7 optional-peer algorithm; no package versions change.
# bun (used in dev) applies the same non-strict resolution by default.
legacy-peer-deps=true
